{{! views/login.hbs }}
<div class="row">
    <div class="col s12 m6 offset-m3">
        <div class="card">
            <div class="card-content">
                <span class="card-title center-align">Добро пожаловать!</span>
                
                <!-- Переключатель вкладок -->
                <div class="row">
                    <div class="col s12">
                        <ul class="tabs">
                            <li class="tab col s6"><a class="active" href="#login">Вход</a></li>
                            <li class="tab col s6"><a href="#register">Регистрация</a></li>
                        </ul>
                    </div>
                    
                    <!-- Форма входа -->
                    <div id="login" class="col s12">
                        <form id="loginForm" class="mt-4">
                            <div class="input-field">
                                <i class="material-icons prefix">account_circle</i>
                                <input type="text" id="login_username" name="login" required>
                                <label for="login_username">Логин</label>
                            </div>
                            
                            <div class="input-field">
                                <i class="material-icons prefix">lock</i>
                                <input type="password" id="login_password" name="password" required>
                                <label for="login_password">Пароль</label>
                            </div>
                            
                            <div class="center-align">
                                <button class="btn waves-effect waves-light teal" type="submit">
                                    Войти <i class="material-icons right">send</i>
                                </button>
                            </div>
                        </form>
                    </div>
                    
                    <!-- Форма регистрации -->
                    <div id="register" class="col s12">
                        <form id="registerForm" class="mt-4">
                            <div class="input-field">
                                <i class="material-icons prefix">person</i>
                                <input type="text" id="reg_fullname" name="full_name" required>
                                <label for="reg_fullname">ФИО</label>
                            </div>
                            
                            <div class="input-field">
                                <i class="material-icons prefix">account_circle</i>
                                <input type="text" id="reg_username" name="login" required>
                                <label for="reg_username">Логин</label>
                            </div>
                            
                            <div class="input-field">
                                <i class="material-icons prefix">phone</i>
                                <input type="tel" id="reg_phone" name="phone">
                                <label for="reg_phone">Телефон</label>
                            </div>
                            
                            <div class="input-field">
                                <i class="material-icons prefix">lock</i>
                                <input type="password" id="reg_password" name="password" required>
                                <label for="reg_password">Пароль</label>
                            </div>
                            
                            <div class="center-align">
                                <button class="btn waves-effect waves-light teal" type="submit">
                                    Зарегистрироваться <i class="material-icons right">person_add</i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Блок для сообщений -->
        <div id="messageBlock" class="card-panel hide"></div>
    </div>
</div>